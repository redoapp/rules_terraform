module(name = "rules_terraform")

# Bazel

bazel_dep(name = "bazel_lib", version = "3.2.1")
bazel_dep(name = "bazel_util")

BAZEL_UTIL_VERSION = "c0dcf8fac981f06ca86d2840761b3703da3a525a"

archive_override(
    module_name = "bazel_util",
    integrity = "sha256-PoekS5Uks+78YYQpIREdHJGicuSB8umpaB25umDdVLk=",
    strip_prefix = "bazel-util-%s" % BAZEL_UTIL_VERSION,
    url = "https://github.com/redoapp/bazel-util/archive/%s.tar.gz" % BAZEL_UTIL_VERSION,
)

# File

include("//tools/file:file.MODULE.bazel")

# Git

include("//tools/git:git.MODULE.bazel")

# JavaScript

bazel_dep(name = "rules_javascript")

RULES_JAVASCRIPT_VERSION = "ac627b6b0276d71d108ec5abc618ec4761240c56"

archive_override(
    module_name = "rules_javascript",
    integrity = "sha256-wNc4w/jMO2Zxc3Nk9W6Pd+RiKV0gv+V9Hd7JQ4fmeYA=",
    strip_prefix = "rules_javascript-%s" % RULES_JAVASCRIPT_VERSION,
    url = "https://github.com/redoapp/rules_javascript/archive/%s.tar.gz" % RULES_JAVASCRIPT_VERSION,
)

include("//tools/javascript:javascript.MODULE.bazel")
include("//tools/nodejs:nodejs.MODULE.bazel")

# Go

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.47.0")

include("//tools/go:go.MODULE.bazel")

# Platforms

bazel_dep(name = "platforms", version = "1.0.0")

# Python

bazel_dep(name = "rules_python", version = "1.8.5")

# Redo Tech

bazel_dep(name = "r_tools", dev_dependency = True)

R_TOOLS_VERSION = "c3c2b65db7cd6d048798c1c8c2501ce706cf4c16"

archive_override(
    module_name = "r_tools",
    integrity = "sha256-lUQDylog5v+SVzgZDVRUY/QK0MGsKnGkEzjQ8RU8m3k=",
    strip_prefix = "r-tools-%s" % R_TOOLS_VERSION,
